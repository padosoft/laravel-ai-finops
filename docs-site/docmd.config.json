{
  "title": "laravel-ai-finops",
  "description": "Enterprise AI spend-governance for Laravel with cross-provider metering, budgets, policies, chargeback, forecasting, and cost-aware routing.",
  "url": "https://doc.laravel-ai-finops.padosoft.com",
  "src": "docs",
  "out": "_site",
  "base": "/",
  "favicon": "/assets/favicon.svg",
  "engine": "js",
  "layout": {
    "spa": true,
    "header": {
      "enabled": true
    },
    "sidebar": {
      "enabled": true,
      "collapsible": true,
      "defaultCollapsed": false,
      "position": "left"
    },
    "optionsMenu": {
      "position": "sidebar-top",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    },
    "footer": {
      "style": "complete",
      "content": "Apache-2.0 © Padosoft. Package by Lorenzo Padovani.",
      "description": "FinOps governance for AI agents running on Laravel.",
      "branding": true,
      "columns": [
        {
          "title": "Project",
          "links": [
            { "label": "GitHub", "href": "https://github.com/padosoft/laravel-ai-finops" },
            { "label": "Issues", "href": "https://github.com/padosoft/laravel-ai-finops/issues" }
          ]
        },
        {
          "title": "Package",
          "links": [
            { "label": "Packagist", "href": "https://packagist.org/packages/padosoft/laravel-ai-finops" },
            { "label": "Docs", "href": "https://doc.laravel-ai-finops.padosoft.com" }
          ]
        }
      ]
    }
  },
  "theme": {
    "name": "default",
    "appearance": "system",
    "codeHighlight": true,
    "customCss": ["/assets/custom.css"],
    "primaryColor": "#0d9488"
  },
  "copyCode": true,
  "pageNavigation": true,
  "minify": true,
  "autoTitleFromH1": true,
  "navigation": [
    { "title": "Overview", "path": "/", "icon": "layout-dashboard" },
    {
      "title": "Get Started",
      "icon": "rocket",
      "children": [
        { "title": "Quickstart", "path": "/get-started/quickstart", "icon": "zap" },
        { "title": "Installation", "path": "/get-started/installation", "icon": "download" },
        { "title": "Configuration", "path": "/get-started/configuration", "icon": "settings" }
      ]
    },
    {
      "title": "Guides",
      "icon": "book-open",
      "children": [
        { "title": "Metering", "path": "/guides/metering", "icon": "activity" },
        { "title": "Budgets & Policies", "path": "/guides/budgets-policies", "icon": "shield-check" },
        { "title": "Pricing & Coverage", "path": "/guides/pricing-coverage", "icon": "coins" },
        { "title": "Chargeback & Forecast", "path": "/guides/chargeback-forecast", "icon": "chart-line" },
        { "title": "Worked Example", "path": "/guides/worked-example", "icon": "play-circle" }
      ]
    },
    {
      "title": "Concetti & Teoria",
      "icon": "brain",
      "children": [
        { "title": "Motivazione", "path": "/concepts/motivazione", "icon": "target" },
        { "title": "Teoria FinOps AI", "path": "/concepts/teoria", "icon": "sigma" },
        { "title": "Cost Cascade", "path": "/concepts/cost-cascade", "icon": "route" }
      ]
    },
    {
      "title": "Architettura",
      "icon": "network",
      "children": [
        { "title": "Overview", "path": "/architecture/overview", "icon": "boxes" },
        { "title": "Pipeline & Workflow", "path": "/architecture/pipeline-workflow", "icon": "workflow" },
        { "title": "Design", "path": "/architecture/design", "icon": "git-branch" },
        { "title": "Modello dati/contratto", "path": "/architecture/data-contract", "icon": "database" },
        { "title": "ADR", "path": "/architecture/adr", "icon": "file-check" }
      ]
    },
    {
      "title": "Best Practices",
      "icon": "badge-check",
      "children": [
        { "title": "Governance", "path": "/best-practices/governance", "icon": "scale" },
        { "title": "Security & Privacy", "path": "/best-practices/security-privacy", "icon": "lock" },
        { "title": "Limits & Gotchas", "path": "/best-practices/limits-gotchas", "icon": "triangle-alert" }
      ]
    },
    {
      "title": "Operations",
      "icon": "terminal",
      "children": [
        { "title": "Runbook", "path": "/operations/runbook", "icon": "clipboard-list" },
        { "title": "Alerts", "path": "/operations/alerts", "icon": "bell" },
        { "title": "Pricing Sync", "path": "/operations/pricing-sync", "icon": "refresh-cw" }
      ]
    },
    {
      "title": "Reference",
      "icon": "braces",
      "children": [
        { "title": "CLI", "path": "/reference/cli", "icon": "terminal-square" },
        { "title": "API", "path": "/reference/api", "icon": "plug" },
        { "title": "PHP API", "path": "/reference/php-api", "icon": "code-2" },
        { "title": "Configuration Reference", "path": "/reference/configuration", "icon": "sliders-horizontal" }
      ]
    }
  ],
  "plugins": {
    "search": {
      "semantic": true,
      "model": "Xenova/all-MiniLM-L6-v2",
      "include": ["**/*.md"],
      "exclude": ["**/drafts/**"],
      "showConfidence": true,
      "showFilters": true
    },
    "git": {
      "repo": "https://github.com/padosoft/laravel-ai-finops",
      "branch": "main",
      "editLink": true,
      "lastUpdated": true,
      "commitHistory": true,
      "maxCommits": 5,
      "dateFormat": "relative"
    },
    "seo": {
      "titleTemplate": "%s | laravel-ai-finops",
      "description": "Enterprise AI spend-governance for Laravel.",
      "ogImage": "/assets/favicon.svg"
    },
    "sitemap": {
      "defaultChangefreq": "weekly",
      "defaultPriority": 0.8,
      "rootPriority": 1
    },
    "mermaid": {
      "theme": "default"
    },
    "math": {},
    "llms": {},
    "analytics": false
  }
}
